# Ship It Shop: environment variables. Copy to .env.local and fill in.
# Names and descriptions only. Never commit real values, and never prefix a
# secret with NEXT_PUBLIC_ (that would expose it to the browser).

# --- Store API -------------------------------------------------------------
# Required. Vercel deployment-protection bypass secret for the Swag Store API.
# Sent with every API call from server code only.
BYPASS_SECRET=

# Optional. Base URL of the Swag Store API (must end in /api).
# Default: https://vercel-agentic-swag-store-api.vercel.app/api
API_BASE_URL=

# --- Model access and Vercel Sandbox ---------------------------------------
# Local development needs ONE of these. On Vercel, neither is needed: the
# deployment authenticates with its own OIDC token.
#
# Option A (recommended): run `vercel link` then `vercel env pull .env.local`.
# That writes VERCEL_OIDC_TOKEN, which authenticates both AI Gateway and
# Vercel Sandbox. It expires after about 12 hours: pull again when it does.
VERCEL_OIDC_TOKEN=
#
# Option B: an AI Gateway API key (starts with "vck_"). It replaces the OIDC
# token for model calls only; Sandbox still needs the OIDC token locally.
AI_GATEWAY_API_KEY=

# --- Site ------------------------------------------------------------------
# Optional. Public site URL, used for metadata. Default: http://localhost:3000
NEXT_PUBLIC_SITE_URL=
